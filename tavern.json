{
  "format": 1,
  "id": "tm-forums",
  "kind": "module",
  "name": "Forums",
  "version": "1.0.0",
  "description": "Web-style forums for Moot Halls and campaigns. Sections group categories; each category opens in its own workspace tab and holds threads and replies, kept as on-demand collection records. Roles made by admins grant per-category access, moderation or admin rights. A dot marks categories with new posts.",
  "authors": [
    "DragonsDrinkFree"
  ],
  "places": [
    "hall",
    "campaign"
  ],
  "rules": "rules.js",
  "permissions": [
    "ui.rail:forums",
    "ui.tab:board"
  ],
  "features": [
    {
      "id": "forums",
      "kind": "rail",
      "label": "Forums",
      "icon": "ui/forums.svg",
      "entry": "ui/rail.html"
    }
  ],
  "collections": [
    {
      "name": "sections",
      "fields": [
        {
          "key": "order",
          "type": "number",
          "index": true
        }
      ],
      "onDelete": "restrict"
    },
    {
      "name": "categories",
      "parent": "sections",
      "fields": [
        {
          "key": "order",
          "type": "number",
          "index": true
        }
      ]
    },
    {
      "name": "threads",
      "parent": "categories",
      "fields": [
        {
          "key": "category",
          "type": "string",
          "index": true
        },
        {
          "key": "lastPost",
          "type": "date",
          "index": true
        },
        {
          "key": "pinned",
          "type": "boolean",
          "index": true
        },
        {
          "key": "title",
          "type": "string",
          "search": true
        }
      ]
    },
    {
      "name": "posts",
      "parent": "threads",
      "fields": [
        {
          "key": "category",
          "type": "string",
          "index": true
        },
        {
          "key": "at",
          "type": "date",
          "index": true
        },
        {
          "key": "body",
          "type": "string",
          "search": true
        }
      ]
    },
    {
      "name": "role-settings",
      "fields": [
        {
          "key": "role",
          "type": "string",
          "index": true
        }
      ]
    },
    {
      "name": "reads",
      "fields": [
        {
          "key": "category",
          "type": "string",
          "index": true
        }
      ],
      "readers": [
        "server:gm"
      ]
    }
  ],
  "tabs": [
    {
      "id": "board",
      "label": "Forums",
      "icon": "ui/forums.svg",
      "entry": "ui/board.html"
    }
  ],
  "settingsPage": "ui/settings.html"
}
