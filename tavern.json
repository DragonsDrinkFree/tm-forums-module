{
  "format": 1,
  "id": "tm-forums",
  "kind": "module",
  "name": "Forums",
  "version": "0.1.0",
  "description": "Web-style forums for Moot Halls and campaigns. Sections group categories; categories hold threads and replies, kept as on-demand collection records. Roles made by admins grant per-category access, moderation or admin rights. Unread counters on every category.",
  "authors": ["Dragons Drink Free"],
  "places": ["hall", "campaign"],
  "rules": "rules.js",
  "permissions": ["ui.rail:forums", "ui.widget:board"],
  "features": [
    {
      "id": "forums",
      "kind": "rail",
      "label": "Forums",
      "icon": "ui/forums.svg",
      "entry": "ui/rail.html"
    }
  ],
  "widgets": [
    {
      "id": "board",
      "label": "Forums",
      "description": "Browse categories, read and write threads, search.",
      "icon": "ui/forums.svg",
      "defaultEnabled": true,
      "full": "ui/board.html"
    }
  ],
  "collections": [
    {
      "name": "sections",
      "fields": [{ "key": "order", "type": "number", "index": true }]
    },
    {
      "name": "categories",
      "parent": "sections",
      "fields": [{ "key": "order", "type": "number", "index": true }]
    },
    {
      "name": "threads",
      "parent": "categories",
      "fields": [
        { "key": "category", "type": "string", "index": true },
        { "key": "lastPost", "type": "date", "index": true },
        { "key": "pinned", "type": "boolean", "index": true },
        { "key": "title", "type": "string", "search": true }
      ]
    },
    {
      "name": "posts",
      "parent": "threads",
      "fields": [
        { "key": "category", "type": "string", "index": true },
        { "key": "at", "type": "date", "index": true },
        { "key": "body", "type": "string", "search": true }
      ]
    },
    {
      "name": "roles",
      "fields": [{ "key": "name", "type": "string", "index": true }]
    },
    {
      "name": "reads",
      "fields": [{ "key": "category", "type": "string", "index": true }],
      "readers": ["server:gm"]
    },
    {
      "name": "nav",
      "readers": ["server:gm"]
    }
  ]
}
